# 이 파일을 `.env` 로 복사해서 값을 채우세요.  cp .env.example .env
#
# `.env` 는 .gitignore 로 막혀 있습니다 — 절대 커밋되지 않습니다.
# 오케스트레이터가 시작할 때 읽어 프로세스 환경변수로 올리고, 자식 프로세스(`ugs` CLI 등)가 그대로 상속합니다.
# 이미 OS 환경변수로 설정된 값이 있으면 그쪽이 우선합니다.

# ── UGS (Phase 4: --target ugs) ────────────────────────────────────────────────
# Unity Cloud 대시보드 → Administration → Service Accounts → Create key
# 필요한 역할: Cloud Code Editor, Unity Environments Viewer (대상 프로젝트에 부여)
UGS_CLI_SERVICE_KEY_ID=
UGS_CLI_SERVICE_SECRET_KEY=

# 배포 대상 프로젝트/환경 (비밀 아님 — 대시보드나 `unity cloud project list` 로 확인)
UGS_CLI_PROJECT_ID=
UGS_CLI_ENVIRONMENT_NAME=production

# ── Anthropic API (백엔드로 --claude/--codex 대신 ApiBackend 를 쓸 때만) ──────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
