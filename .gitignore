# Unity + .NET(orchestrator) .gitignore
# based on github/gitignore Unity.gitignore

# --- AgentLoop ---
# 실행 기록·트레이스(로컬 작업 데이터). layout.json 은 팀 공유가 되도록 추적한다.
.agentloop/*
!.agentloop/layout.json

# 벤치마크 샌드박스 = 별도 Unity 프로젝트.
# 뼈대(ProjectSettings/manifest/asmdef)는 추적해 누구나 같은 환경을 재현하게 하고,
# Unity 가 만들어 내는 것과 생성물은 무시한다.
Benchmark/Sandbox/.agentloop/*
!Benchmark/Sandbox/.agentloop/layout.json
Benchmark/Sandbox/Benchmark/
Benchmark/Sandbox/[Ll]ibrary/
Benchmark/Sandbox/[Tt]emp/
Benchmark/Sandbox/[Ll]ogs/
Benchmark/Sandbox/[Oo]bj/
Benchmark/Sandbox/[Uu]ser[Ss]ettings/
Benchmark/Sandbox/[Bb]uild*/
Benchmark/Sandbox/*.csproj
Benchmark/Sandbox/*.sln
Benchmark/Sandbox/Assets/Scripts/*.cs
Benchmark/Sandbox/Assets/Scripts/*.cs.meta
Benchmark/Sandbox/Assets/Tests/PlayMode/*.cs
Benchmark/Sandbox/Assets/Tests/PlayMode/*.cs.meta

# --- Unity generated ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta / tools
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Auto-generated project/solution files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt

# Builds / packages
*.apk
*.aab
*.unitypackage
*.app

# --- IDE ---
.vs/
.idea/
.gradle/
*.iws
out/

# --- .NET orchestrator (Orchestrator/) ---
[Bb]in/
[Oo]bj/

# Unity 는 루트에 Assembly-CSharp.csproj 등을 자동 생성하므로 위에서 *.csproj/*.sln 을 무시한다.
# 단, 손으로 작성한 Orchestrator 프로젝트 파일은 반드시 커밋한다(예외).
!Orchestrator/**/*.csproj
!Orchestrator/**/*.sln

# --- Secrets (절대 커밋 금지) ---
.env
*.env
appsettings.*.local.json
secrets.json
